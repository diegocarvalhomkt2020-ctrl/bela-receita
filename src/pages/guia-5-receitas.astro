---
import Layout from '../layouts/Layout.astro';
import dados from '../data/receitas.json';

const idsGuia = [
  'batata-frita-crocante-air-fryer',
  'coxinha-de-frango-air-fryer',
  'nuggets-caseiros-air-fryer',
  'pizza-na-air-fryer',
  'pudim-de-leite-condensado-air-fryer',
];

const receitas = idsGuia
  .map((id) => dados.receitas.find((r) => r.id === id))
  .filter(Boolean);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://belareceita.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Guia 5 receitas", item: "https://belareceita.dicasinteligentes.com/guia-5-receitas/" },
  ],
};
---
<Layout
  title="5 receitas prontas pra fazer hoje"
  description="As 5 receitas de air fryer que mais saem daqui: batata frita crocante, coxinha, nuggets, pizza e pudim, com o segredo técnico de cada uma."
  image={receitas[0]?.imagem}
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <p><a href="/">← Início</a></p>

  <p class="selo">GUIA GRATUITO</p>
  <h1>5 receitas prontas pra fazer hoje</h1>
  <p class="intro">Você seguiu, marcou uma amiga e chegou até aqui. Essas são as 5 receitas completas, do jeito que a gente faz de verdade, com o segredo técnico de cada uma na própria página.</p>

  <div class="grade">
    {receitas.map((r) => (
      <a href={`/receitas/${r.id}/`} class="cartao">
        <img src={r.imagem.replace('.jpg', '-mini.jpg')} alt={r.resumo} width="360" height="640" loading="lazy" />
        <div class="cartao-texto">
          <h2>{r.nome}</h2>
          <p>{r.subtitulo}</p>
        </div>
      </a>
    ))}
  </div>

  <p class="cta-final">
    Gostou? <a href="/receitas/">Veja todas as receitas do site →</a>
  </p>

  <style>
    .selo {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--cor-acento);
      margin: 1rem 0 0.6rem;
    }
    .intro { color: var(--cor-texto-suave); max-width: 560px; margin: 1rem 0 2rem; }
    .grade {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    .cartao {
      display: block;
      text-decoration: none;
      color: var(--cor-texto);
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 12px;
      overflow: hidden;
    }
    .cartao img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
    .cartao-texto { padding: 1rem; }
    .cartao h2 { font-size: 1.05rem; margin: 0 0 0.4rem; }
    .cartao p { font-size: 0.85rem; color: var(--cor-texto-suave); margin: 0; }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
