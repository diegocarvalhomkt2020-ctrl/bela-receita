---
import Layout from '../../layouts/Layout.astro';
import dados from '../../data/receitas.json';

export function getStaticPaths() {
  return dados.receitas.map((r) => ({
    params: { id: r.id },
    props: { receita: r },
  }));
}

const { receita: r } = Astro.props;

const tempoTotalMin = r.tempoPreparoMin + r.tempoCozimentoMin + (r.tempoExtra?.min || 0);

function paraISO8601(min) {
  return `PT${min}M`;
}

const imagemAbsoluta = new URL(r.imagem, Astro.site).toString();

const faqSchema = r.faq.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": r.faq.map((f) => ({
    "@type": "Question",
    "name": f.pergunta,
    "acceptedAnswer": { "@type": "Answer", "text": f.resposta },
  })),
} : null;

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": new URL('/', Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Receitas", "item": new URL('/receitas/', Astro.site).toString() },
    { "@type": "ListItem", "position": 3, "name": r.nome, "item": new URL(`/receitas/${r.id}/`, Astro.site).toString() },
  ],
};

const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": r.nome,
  "image": [imagemAbsoluta],
  "description": r.resumo,
  "datePublished": r.dataPublicacao,
  "author": { "@type": "Organization", "name": "Bela Receita" },
  "recipeYield": `${r.porcoes} ${r.porcoesLabel}`,
  "prepTime": paraISO8601(r.tempoPreparoMin),
  "cookTime": paraISO8601(r.tempoCozimentoMin + (r.tempoExtra?.min || 0)),
  "totalTime": paraISO8601(tempoTotalMin),
  "recipeIngredient": r.ingredientes,
  "recipeInstructions": r.modoPreparo.map((passo) => ({
    "@type": "HowToStep",
    "name": passo.titulo,
    "text": `${passo.titulo}: ${passo.texto}`,
  })),
};
---
<Layout title={r.nome} description={r.resumo}>
  <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <nav class="trilha">
    <a href="/">Início</a> &rsaquo; <a href="/receitas/">Receitas</a> &rsaquo; {r.nome}
  </nav>

  <h1>{r.nome}</h1>
  <p class="subtitulo">{r.subtitulo}</p>

  <img src={r.imagem} alt={r.nome} class="foto-capa" width="720" height="960" />

  <p>{r.introducao}</p>

  <section class="caixa-receita">
    <h2>{r.porQue.titulo}</h2>
    <p>{r.porQue.texto}</p>

    <div class="metadados">
      <div><strong>Preparo</strong><span>{r.tempoPreparoMin} min</span></div>
      <div><strong>Cocção</strong><span>{r.tempoCozimentoMin} min</span></div>
      {r.tempoExtra && <div><strong>{r.tempoExtra.label}</strong><span>{r.tempoExtra.min} min</span></div>}
      <div><strong>Rende</strong><span>{r.porcoes} {r.porcoesLabel}</span></div>
    </div>

    <h3>Ingredientes</h3>
    <ul class="lista-ingredientes">
      {r.ingredientes.map((ing) => <li>{ing}</li>)}
    </ul>

    <h3>Modo de preparo</h3>
    <ol class="lista-preparo">
      {r.modoPreparo.map((passo) => (
        <li><strong>{passo.titulo}:</strong> {passo.texto}</li>
      ))}
    </ol>
  </section>

  <div class="vale-saber">
    <strong>Dica de quem já testou</strong>
    <p>{r.dica}</p>
  </div>

  {r.faq.length > 0 && (
    <section>
      <h2>Perguntas frequentes</h2>
      {r.faq.map((f) => (
        <div class="faq-item">
          <h3>{f.pergunta}</h3>
          <p>{f.resposta}</p>
        </div>
      ))}
    </section>
  )}

  <p class="cta-ebook">
    Gostou dessa receita? Se você curte praticidade na air fryer, dá uma olhada no e-book
    <strong> Air Fryer Sem Segredo</strong>, com 30 receitas fáceis e testadas para air fryer.
    <a href="https://ebook.dicasinteligentes.com/">Confira aqui →</a>
  </p>

  <style>
    .trilha {
      font-size: 0.85rem;
      color: var(--cor-texto-suave);
      margin-bottom: 1rem;
    }
    .trilha a { color: var(--cor-texto-suave); }
    .subtitulo {
      color: var(--cor-texto-suave);
      margin-top: -0.5rem;
      font-size: 1.05rem;
    }
    .foto-capa {
      width: 100%;
      max-width: 480px;
      height: auto;
      border-radius: 12px;
      display: block;
      margin: 1.5rem 0;
    }
    .caixa-receita {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 12px;
      padding: 1.5rem;
      margin: 2rem 0;
    }
    .metadados {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 0.75rem;
      background: var(--cor-fundo);
      border-radius: 8px;
      padding: 1rem;
      margin: 1rem 0 1.5rem;
      text-align: center;
    }
    .metadados strong { display: block; font-size: 0.75rem; color: var(--cor-texto-suave); text-transform: uppercase; letter-spacing: 0.03em; }
    .metadados span { font-size: 1.1rem; font-weight: 600; }
    .lista-ingredientes { padding-left: 1.2rem; }
    .lista-ingredientes li { margin-bottom: 0.4rem; }
    .lista-preparo { padding-left: 1.2rem; }
    .lista-preparo li { margin-bottom: 0.9rem; }
    .vale-saber {
      background: #fff8ec;
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 4px;
      padding: 1rem 1.25rem;
      margin: 2rem 0;
    }
    .vale-saber strong { color: var(--cor-vale-saber); }
    .vale-saber p { margin: 0.4rem 0 0; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1.05rem; margin-bottom: 0.3rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }
    .cta-ebook {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 12px;
      padding: 1.25rem;
      margin-top: 2.5rem;
    }
  </style>
</Layout>
