---
const { title, description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(image || '/images/receitas/nuggets.jpg', Astro.site).toString();
const pathname = Astro.url.pathname;
const ehAtual = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>%F0%9F%8D%B0</text></svg>" />
    <title>{title} | Bela Receita</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="AFQmk0EicCrPLG25m9s-2JTl8IR5paLf9pNyeLl70Ek" />
    <meta name="p:domain_verify" content="561fb5da0b66e3c736f96595acf093be" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bela Receita" />
    <meta property="og:title" content={`${title} | Bela Receita`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={imagemAbsoluta} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Bela Receita`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemAbsoluta} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S9W1JLE1QY"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S9W1JLE1QY');
    </script>
  </head>
  <body>
    <header class="topo">
      <div class="topo-inner">
        <a href="/" class="marca"><span class="marca-emoji">🍰</span> Bela Receita</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir menu">
          <span class="menu-toggle-icon"></span>
        </button>
        <nav id="menu-principal">
          <a href="/receitas/" aria-current={ehAtual('/receitas/') ? 'page' : undefined}>Receitas</a>
        </nav>
      </div>
    </header>
    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const menuPrincipal = document.querySelector('#menu-principal');
      if (menuToggle && menuPrincipal) {
        menuToggle.addEventListener('click', () => {
          const aberto = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!aberto));
          menuPrincipal.classList.toggle('aberto');
        });
      }
    </script>
    <main>
      <slot />
    </main>
    <footer class="rodape">
      <p>
        <strong>Aviso de transparência.</strong> Este site participa de programas
        de afiliados e pode receber comissão pelas compras qualificadas feitas
        através dos links, sem custo adicional para você.
      </p>
      <p><a href="/privacidade/">Política de Privacidade</a></p>
    </footer>
    <style is:global>
      :root {
        --cor-texto: #262521;
        --cor-texto-suave: #6b6a63;
        --cor-fundo: #fbfaf6;
        --cor-superficie: #ffffff;
        --cor-borda: #e4e1d6;
        --cor-acento: #a12a2a;
        --cor-vale-saber: #c98a1f;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, "Segoe UI", Arial, sans-serif;
        color: var(--cor-texto);
        background: var(--cor-fundo);
        line-height: 1.6;
      }
      h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 600; }
      a { color: var(--cor-acento); }
      a:hover { text-decoration-thickness: 2px; }
      .topo {
        position: sticky;
        top: 0;
        z-index: 10;
        padding: 0 1.5rem;
        border-bottom: 1px solid var(--cor-borda);
        background: var(--cor-superficie);
        box-shadow: 0 1px 4px rgba(0,0,0,0.045);
      }
      .topo-inner {
        max-width: 760px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.9rem 0;
      }
      .marca {
        font-weight: 700;
        text-decoration: none;
        color: var(--cor-acento);
        font-family: Georgia, serif;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
        white-space: nowrap;
      }
      .marca-emoji { font-size: 1.15em; }
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
      }
      .menu-toggle-icon,
      .menu-toggle-icon::before,
      .menu-toggle-icon::after {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--cor-texto);
        border-radius: 2px;
      }
      .menu-toggle-icon { position: relative; }
      .menu-toggle-icon::before,
      .menu-toggle-icon::after {
        content: '';
        position: absolute;
        left: 0;
      }
      .menu-toggle-icon::before { top: -7px; }
      .menu-toggle-icon::after { top: 7px; }
      .topo nav a {
        color: var(--cor-texto-suave);
        font-weight: 600;
        text-decoration: none;
        padding: 0.5rem 0.75rem;
        margin-left: 0.25rem;
        border-radius: 6px;
      }
      .topo nav a:hover { color: var(--cor-acento); background: var(--cor-fundo); }
      .topo nav a[aria-current="page"] { color: var(--cor-acento); background: var(--cor-fundo); text-decoration: underline; }
      .topo nav { display: flex; flex-wrap: wrap; align-items: center; }
      @media (max-width: 820px) {
        .menu-toggle { display: block; }
        .topo-inner { flex-wrap: wrap; }
        .topo nav {
          display: none;
          flex-direction: column;
          align-items: stretch;
          width: 100%;
          padding: 0.5rem 0 0.9rem;
        }
        .topo nav.aberto { display: flex; }
        .topo nav a { margin-left: 0; margin-top: 0.25rem; }
      }
      main { max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem; }
      .rodape {
        max-width: 720px;
        margin: 3rem auto 0;
        padding: 1.5rem;
        border-top: 1px solid var(--cor-borda);
        color: var(--cor-texto-suave);
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
